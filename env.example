# ==============================================================================
# BusinessHub AI - Global Environment Configuration Template (.env.example)
# Place this file at the project root: businesshub-ai/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global Application Settings
# ------------------------------------------------------------------------------
APP_ENV=development                       # Options: development, staging, production
APP_NAME="BusinessHub AI"
DEBUG=true
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS='["http://localhost:4200", "http://127.0.0.1:4200"]'

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_secure_123
POSTGRES_DB=businesshub_db
POSTGRES_HOST=localhost                   # Use "db" if running backend inside Docker Compose
POSTGRES_PORT=5432

# SQLAlchemy connection string (asyncpg driver required for native async)
DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# ------------------------------------------------------------------------------
# 3. Cache & Message Broker (Redis 7)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost                      # Use "redis" if running backend inside Docker Compose
REDIS_PORT=6379
REDIS_DB=0

# Redis connection URLs
REDIS_URL="redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}"
CELERY_BROKER_URL="redis://${REDIS_HOST}:${REDIS_PORT}/1"
CELERY_RESULT_BACKEND="redis://${REDIS_HOST}:${REDIS_PORT}/2"

# ------------------------------------------------------------------------------
# 4. Security & Authentication (JWT & RBAC)
# ------------------------------------------------------------------------------
# The platform mandates RS256 (asymmetric keys) as per NFR 6.2.
# For development, you can generate a pair using openssl:
# openssl genpkey -algorithm RSA -out private_key.pem -pkeyopt rsa_keygen_bits:2048
# openssl rsa -pubout -in private_key.pem -out public_key.pem
#
# Provide the file paths or base64-encoded strings of the PEM keys:
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH="/absolute/path/to/private_key.pem"
JWT_PUBLIC_KEY_PATH="/absolute/path/to/public_key.pem"

# Alternatively, if loading from raw base64 (useful for production/K8s/Render):
# JWT_PRIVATE_KEY_BASE64="LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLS..."
# JWT_PUBLIC_KEY_BASE64="LS0tLS1CRUdJTiBQVUJMSUMgS0VZLS0tLS0..."

# Token Expirations (in minutes/days) as per FR-CORE-01
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 5. Object Storage Configuration (Local MinIO / Cloudflare R2)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local                    # Options: local (MinIO), cloud (R2/S3)

# AWS/S3 compatible API credentials
AWS_ACCESS_KEY_ID=minio_admin_user
AWS_SECRET_ACCESS_KEY=minio_admin_password_secure_123
AWS_DEFAULT_REGION=us-east-1
AWS_STORAGE_BUCKET_NAME=businesshub-media

# MinIO Local Configuration (Ignored if STORAGE_PROVIDER=cloud)
MINIO_ENDPOINT=http://localhost:9000      # Use "http://minio:9000" inside Docker
MINIO_CONSOLE_PORT=9001

# Production Cloudflare R2 Configuration (Ignored if STORAGE_PROVIDER=local)
# CLOUDFLARE_R2_ACCOUNT_ID=your_account_id_here
# CLOUDFLARE_R2_ENDPOINT_URL="https://${CLOUDFLARE_R2_ACCOUNT_ID}.r2.cloudflarestorage.com"

# ------------------------------------------------------------------------------
# 6. Billing & Subscription Gateways (Stripe Sandbox)
# ------------------------------------------------------------------------------
STRIPE_API_KEY=sk_test_51P...             # Stripe Test Mode Secret Key
STRIPE_WEBHOOK_SECRET=whsec_...           # Obtained via Stripe CLI

# ------------------------------------------------------------------------------
# 7. AI Platform Services (LLM Gateway Providers)
# ------------------------------------------------------------------------------
# Centralised model provider API keys. Feature modules do NOT access these directly.
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...

# Default model definitions used by the AI Gateway
DEFAULT_LLM_MODEL=gpt-4o
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 8. Observability & Monitoring
# ------------------------------------------------------------------------------
SENTRY_DSN=""                             # Add your Sentry DSN for error logging
LOG_LEVEL=info                            # Options: debug, info, warning, error, critical
STRUCTLOG_JSON_FORMAT=true                # Formats log output in structured JSON
